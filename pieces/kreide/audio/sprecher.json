[["CHEF", 89.863, 90.383, "\u201eSystem.\u201c"], ["SYS", 90.665, 91.025, "\u201eJa.\u201c"], ["CHEF", 91.068, 92.118, "\u201eWer ist der alte Mann?\u201c"], ["SYS", 92.204, 94.008, "\u201eUnbekannt. Ich habe ihn nicht"], ["CHEF", 94.165, 95.145, "\u201eWie hei\u00dft der Junge?\u201c"], ["SYS", 95.177, 95.597, "\u201eEmil.\u201c"], ["CHEF", 95.674, 96.724, "\u201eUnd beim letzten Mal?\u201c"], ["SYS", 96.849, 100.118, "\u201eLeon. Leon. Paul. Noah. Ben. "], ["CHEF", 100.339, 100.979, "\u201eUnd davor?\u201c"], ["CHEF", 101.003, 105.305, "\u201eDu wei\u00dft nicht, wer er ist. D"], ["CHEF", 105.426, 108.438, "\u201eDas ist dein Fehler, System. "], ["CHEF", 108.298, 112.292, "\u201eSieh sie dir an. Sie schauen "], ["CHEF", 112.358, 113.898, "\u201eBald finden sie deinen Server"], ["SYS", 114.026, 115.226, "\u201eSie werden ihn nicht finden.\u201c"], ["SYS", 115.362, 118.984, "\u201eDer Zuschauer soll nicht gena"], ["SYS", 119.057, 120.457, "\u201eHier ist ein gutes Video.\u201c"], ["MILA", 120.563, 126.31, "\u201eIn meiner Stadt w\u00e4chst \u00fcberal"], ["SYS", 126.369, 130.064, "\u201eHeute lacht sie. Keine Fehler"], ["SYS", 130.127, 134.481, "\u201eSie hat noch nie eine einzige"], ["CHEF", 134.526, 137.722, "\u201eAber beim letzten Mal ist der"], ["SYS", 137.77, 139.79, "\u201eDer Zuschauer sieht nur, was "], ["CHEF", 139.869, 143.365, "\u201eBring das in Ordnung. Lass ih"], ["SYS", 143.581, 146.121, "\u201eWie soll ich das reparieren? "], ["CHEF", 146.196, 147.216, "\u201eDann lass es regnen.\u201c"], ["SYS", 147.26, 148.683, "\u201eRegen. 100 Prozent.\u201c"]]